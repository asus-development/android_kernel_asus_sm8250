# Asus Kona Platform
CONFIG_MACH_ASUS_ZS670KS=y

# Battery and USB Power Delivery 
CONFIG_ASUS_HVDCP_LIMIT=y
CONFIG_ASUS_PD_CHARGER=y

# CGroup  Notify event
CONFIG_CGF_NOTIFY_EVENT=y

# Goodix
CONFIG_GOODIX3626_FINGERPRINT=y

# Hall sensor 2
CONFIG_SENSORS_HALL2=y

# Regulator
CONFIG_REGULATOR_PM8008=y

# Sensor gyroscope and ASH
CONFIG_SENSORS_ICM206XX=y