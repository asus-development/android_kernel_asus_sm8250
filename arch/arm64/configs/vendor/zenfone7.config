# Asus Kona Platform
CONFIG_MACH_ASUS_ZS670KS=y

# Battery and USB Power Delivery 
CONFIG_ASUS_HVDCP_LIMIT=y
CONFIG_ASUS_PD_CHARGER=y

# CGroup  Notify event
CONFIG_CGF_NOTIFY_EVENT=y

# DRM
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_LCD_SUPPORT=y

# DTB Overlay
CONFIG_BUILD_ARM64_DT_OVERLAY=y

# Goodix
CONFIG_GOODIX3626_FINGERPRINT=y

# Hall sensor 2
CONFIG_SENSORS_HALL2=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Regulator
CONFIG_REGULATOR_PM8008=y

# Sdfat
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_SDFAT_FS=y
CONFIG_SDFAT_SUPPORT_DIR_SYNC=y
CONFIG_SDFAT_CHECK_RO_ATTR=y
# CONFIG_SDFAT_DEBUG is not set

# Sensor gyroscope and ASH
CONFIG_SENSORS_ICM206XX=y

# Wlan
CONFIG_QCA_CLD_WLAN=m
CONFIG_QCA_CLD_WLAN_PROFILE="qca6390"
CONFIG_CNSS_QCA6390=y

# Zram
CONFIG_ZRAM_WRITEBACK=y
